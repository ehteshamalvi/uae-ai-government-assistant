# GovFlow AI — local environment example
# Copy to apps/api/.env and fill values. Never commit real secrets.

NODE_ENV=development
PORT=3001

# CORS — comma-separated origins allowed (required in production)
WEB_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://govflow:govflow@localhost:5432/govflow?schema=public

# Redis (optional — API falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# AI — mock by default (OpenAI never required)
AI_PROVIDER=mock
OPENAI_API_KEY=

# Council Demo Mode (defaults true when not production)
DEMO_MODE=true

# Rate limiting (optional)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120
# THROTTLE_COPILOT_LIMIT=30
# THROTTLE_INTENT_LIMIT=40

# Copilot limits (optional)
# COPILOT_MAX_MESSAGE_LENGTH=2000
# COPILOT_MAX_HISTORY=8
# COPILOT_MAX_KNOWLEDGE_CHUNKS=3
# COPILOT_MAX_ANSWER_LENGTH=2000
# COPILOT_MIN_KNOWLEDGE_SCORE=2

# Document storage (local filesystem)
# DOCUMENT_STORAGE_PATH=./storage/documents
# MAX_UPLOAD_BYTES=10485760

# Frontend (apps/web/.env)
# VITE_API_BASE_URL=/api
# VITE_DEMO_USER_EMAIL=khalid.demo@govflow.ai
