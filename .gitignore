# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/
*.tsbuildinfo
.next/
.turbo/

# Environment & secrets — never commit real env files
.env
.env.*
!.env.example
!**/.env.example
apps/api/.env
apps/web/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# IDE / OS / editor
.idea/
.vscode/*
!.vscode/extensions.json
.cursor/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Prisma / local DBs
apps/api/prisma/*.db
apps/api/prisma/*.db-journal
*.db
*.db-journal
*.sqlite
*.sqlite3

# Uploads / local storage / embedded runtime
apps/api/storage/
apps/api/.data/
.data/
uploads/
tmp/
temp/
*.tmp

# Coverage / test
coverage/
**/coverage/
.nyc_output/

# Certificates / keys
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*

# Misc
.cache/
